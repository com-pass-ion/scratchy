;; -*- mode: lisp-data -*- ;; -*- lexical-binding: t; -*-

;; Standard IDE Snippets for Scratchy
;; Usage: M-+ (tempel-complete) or M-* (tempel-insert)

fundamental-mode

;; Date/time
(today (format-time-string "%Y-%m-%d"))
(now (format-time-string "%H:%M:%S"))
(timestamp (format-time-string "%Y-%m-%dT%H:%M:%S"))

prog-mode

;; Comments
(fixme (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "FIXME ")
(todo (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "TODO ")
(bug (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "BUG ")
(hack (if (derived-mode-p 'emacs-lisp-mode) ";; " comment-start) "HACK ")

c-mode c++-mode

;; Control flow
(if "if (" p ") {" n> r> n "}")
(ife "if (" p ") {" n> r> n "} else {" n> r> n "}")
(elif "else if (" p ") {" n> r> n "}")
(for "for (" p "; " p "; " p ") {" n> r> n "}")
(while "while (" p ") {" n> r> n "}")
(switch "switch (" p ") {" n> r> n "}")
(case "case " p ":" n> r> n "break;")
(default "default:" n> r> n "break;")
(return "return " p ";")
(printf "printf(\"" p "\\n\");")
(fmt "fprintf(stderr, \"" p "\\n\");")

;; Functions
(main "int main(void) {" n> r> n "    return 0;" n "}")
(fun "int " p "(" p ") {" n> r> n "}")
(void "void " p "(" p ") {" n> r> n "}")

;; Classes and structs
(class "struct " p " {" n> r> n "};")
(ifdef "#ifndef " p n "#define " p n n> r> n "#endif")

;; Memory
(malloc (p "type" type) "* " p " = (" type "*)malloc(sizeof(" type "));")
(free "free(" p ");")

python-mode

;; Control flow
(if "if " p ":" n> r> n "")
(ife "if " p ":" n> r> n "else:" n> r> n "")
(elif "elif " p ":" n> r> n "")
(for "for " p " in " p ":" n> r> n "")
(while "while " p ":" n> r> n "")
(try "try:" n> r> n "except " p ":" n> r> n "")
(trye "try:" n> r> n "except " p " as " p ":" n> r> n "")

;; Functions
(def "def " p "(" p "):" n> r> n "")
(defm "def " p "(self" p "):" n> r> n "")
(cls "class " p "(" p "):" n> r> n "pass")
(init "def __init__(self" p "):" n> r> n "pass")
(main "if __name__ == '__main__':" n> r> n "")

;; Strings
(fstr "f\"" p "\"")
(spr "format(\"" p "\")")

;; Common
(print "print(" p ")")
(return "return " p "")

sh-mode bash-mode

;; Control flow
(if "if [ " p " ]; then" n> r> n "fi")
(ife "if [ " p " ]; then" n> r> n "else" n> r> n "fi")
(for "for " p " in " p "; do" n> r> n "done")
(while "while [ " p " ]; do" n> r> n "done")
(case "case " p " in" n> r> n "esac")

;; Functions
(fun p "() {" n> r> n "}")
(main "main() {" n> r> n "}")

;; Common
(echo "echo \"" p "\"")
(read "read -p \"" p "\" " p)
(ifile "[ -f " p " ]")
(idir "[ -d " p " ]")

elisp emacs-lisp-mode

;; Control flow
(when "(when " p n> r> n ")")
(unless "(unless " p n> r> n ")")
(if "(if " p n> r> n ")")
(let "(let (" p ")" n> r> n ")")
(lett "(let* (" p ")" n> r> n ")")
(cond "(cond" n "(" q "))")

;; Definitions
(fun "(defun " p " (" p ")" n> "  \"" p "\"" n> r> n ")")
(var "(defvar " p nil "  \"" p "\"")
(const "(defconst " p nil "  \"" p "\"")
(custom "(defcustom " p nil "  \"" p "\"" n> ":type '" p ")")

;; Macros
(mac "(defmacro " p " (" p ")" n> "  \"" p "\"" n> r> n ")")

;; Testing
(ert "(ert-deftest " p " ()" n> "  " p n ")")

;; Common
(interactive "(interactive)")
(provide "(provide '" (file-name-base (or (buffer-file-name) (buffer-name))) ")")

java-mode

;; Control flow
(if "if (" p ") {" n> r> n "}")
(ife "if (" p ") {" n> r> n "} else {" n> r> n "}")
(for "for (" p ") {" n> r> n "}")
(while "while (" p ") {" n> r> n "}")
(try "try {" n> r> n "} catch (" p ") {" n> r> n "}")

;; Functions
(main "public static void main(String[] args) {" n> r> n "}")
(fun "public " p " " p "(" p ") {" n> r> n "}")
(void "public void " p "(" p ") {" n> r> n "}")

;; Classes
(class "public class " p " {" n> r> n "}")
(interface "public interface " p " {" n> r> n "}")

;; Common
(sout "System.out.println(" p ");")
(serr "System.err.println(" p ");")
(sup "super." p "(" p ");")

org-mode

(src "#+begin_src " q n r n "#+end_src")
(begin "#+begin_" (s name) n> r> n "#+end_" name)
(quote "#+begin_quote" n> r> n "#+end_quote")
(example "#+begin_example" n> r> n "#+end_example")
(comment "#+begin_comment" n> r> n "#+end_comment")
(title "#+title: " p n "#+author: " p)
(caption "#+caption: ")
(drawer ":" p ":" n r ":end:")

latex-mode

(begin "\\begin{" (s env) "}" r> n> "\\end{" env "}")
(document "\\begin{document}" r> n> "\\end{document}")
(equation "\\begin{equation}" r> n> "\\end{equation}")
(itemize "\\begin{itemize}" n> "\\item " r> n> "\\end{itemize}")
(enumerate "\\begin{enumerate}" n> "\\item " r> n> "\\end{enumerate}")

markdown-mode

(code "```" q n r n "```")
(link "[" p "](url)")
(image "![" p "](url)")
(table "|" p " | " p " |" n "|" "--- | --- |" n "|" p " | " p " |")

nix-mode

(fun p " = {" n> r> n "};")
(module "{ config, lib, pkgs, ... }:" n n "{" n> r> n "}")
