#!/bin/bash
# Git pre-commit hook
# Smart orchestrator for pre-commit validation

set -euo pipefail

echo "Running pre-commit validation..."
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. Determine required tier based on changes
# Default to fast
TIER="fast"

# Changes to build scripts or master branch (approximate) trigger Absolute-Pass
if git diff --cached --name-only | grep -qE 'build_emacs_source.sh|install_emacs_config_dependencies.sh'; then
    echo "Toolchain changes detected. Triggering Absolute-Pass..."
    TIER="absolute"
# Changes to elisp, shell scripts, or dotfiles trigger Functional-Pass
elif git diff --cached --name-only | grep -qE '\.(el|sh)$|dotfiles/'; then
    echo "Code changes detected. Triggering Functional-Pass..."
    TIER="functional"
fi

# 2. Execute the corresponding pipeline
if bash "$SCRIPT_DIR/run_tests.sh" "$TIER"; then
    echo "Pre-commit validation ($TIER) passed!"
    exit 0
else
    echo "Pre-commit validation ($TIER) failed! Commit aborted."
    exit 1
fi
